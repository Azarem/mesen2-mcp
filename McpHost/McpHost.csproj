<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MesenMcpHost</AssemblyName>
    <RootNamespace>MesenMcpHost</RootNamespace>
    <!-- One place for the version: the VERSION file at the repo root. Bump it to publish a release. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\tools\lua\lib\**\*.lua" Link="lua\lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI\UI.csproj" />
  </ItemGroup>
</Project>
